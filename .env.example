PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# Global admin magic-link identity
GLOBAL_ADMIN_EMAIL=admin@example.com

# SMTP settings (AWS SES SMTP credentials work here)
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_REPLY_TO=

# Optional auth tuning
AUTH_MAGIC_LINK_TTL_MINUTES=15
AUTH_SESSION_TTL_HOURS=12
